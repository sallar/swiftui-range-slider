// Shared.xcconfig
// Settings common to every configuration of the example app.

PRODUCT_NAME = RangeSliderExample
PRODUCT_BUNDLE_IDENTIFIER = com.sallar.RangeSliderExample
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// One target, both platforms.
SDKROOT = auto
SUPPORTED_PLATFORMS = macosx iphonesimulator iphoneos
TARGETED_DEVICE_FAMILY = 1,2
MACOSX_DEPLOYMENT_TARGET = 26.0
IPHONEOS_DEPLOYMENT_TARGET = 26.0

SWIFT_VERSION = 6.0
ENABLE_PREVIEWS = YES
ALWAYS_SEARCH_USER_PATHS = NO

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_CFBundleDisplayName = RangeSlider
INFOPLIST_KEY_UILaunchScreen_Generation = YES
INFOPLIST_KEY_NSHumanReadableCopyright =

ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon

// The example is only ever run locally.
CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -
